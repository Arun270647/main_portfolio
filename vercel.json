{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "arunvignesh.my" }],
      "destination": "https://www.arunvignesh.my/:path*",
      "permanent": true
    },
    { "source": "/skills", "destination": "/about#toolbox", "permanent": true },
    { "source": "/certificates", "destination": "/about", "permanent": true },
    { "source": "/contact", "destination": "/#contact", "permanent": true },
    { "source": "/blog", "destination": "/projects", "permanent": true },
    { "source": "/blog/track-my-academy", "destination": "/projects#track-my-academy", "permanent": true },
    { "source": "/blog/marina-digitals", "destination": "/projects#marina-digitals", "permanent": true },
    { "source": "/blog/fufies", "destination": "/projects#fufies", "permanent": true },
    { "source": "/blog/kyra-elite", "destination": "/projects#kyra-elite", "permanent": true },
    { "source": "/blog/hand-cricket-ai", "destination": "/projects#hand-cricket-ai", "permanent": true },
    { "source": "/blog/:slug", "destination": "/projects", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|png|ico|pdf|woff2)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
